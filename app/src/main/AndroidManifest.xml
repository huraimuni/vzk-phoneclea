<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 인터넷: 로그인·가족 연결·화면 공유에만 사용합니다. 앱 점검 결과는 밖으로 보내지 않습니다. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 화면 공유 중 상대가 보낸 동그라미·안내 문구를 화면 위에 보여 주기 위한 권한(선택, 화면을 대신 조작하지 않음) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="com.android.vending.BILLING" />
    <!-- 설치된 앱 목록을 읽기 위한 권한 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- 사용자가 선택한 앱의 삭제 확인 창을 띄우기 위한 권한 -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- 의심 앱의 백그라운드 실행을 일시 중지(종료)시키기 위한 권한 -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- 저장공간 관리: 중복 사진·영상 찾기 (사용자가 기능을 열 때만 허용 요청) -->
    <!-- 저장공간 관리: 중복 연락처 찾기/삭제 -->
    <!-- 정확도 향상(선택): 사용자가 설정에서 허용하면 '한 번도 안 열어 본 앱'을 알 수 있음 -->
    <!-- 새 앱 설치 알림(선택) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 상시 감시 모드(선택): 새 앱 설치를 바로 알려 주기 위한 상시 실행 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 화면 공유(부모가 [허용]을 눌렀을 때만 동작) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LanguageActivity"
            android:exported="false" />
        <activity
            android:name=".LoginActivity"
            android:exported="false" />
        <activity
            android:name=".FamilyActivity"
            android:exported="false" />
        <activity
            android:name=".ConsentActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />
        <activity
            android:name=".ViewerActivity"
            android:exported="false" />
        <activity
            android:name=".SubscribeActivity"
            android:exported="false" />
        <activity
            android:name=".LogActivity"
            android:exported="false" />
        <service
            android:name=".ShareService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
        <activity
            android:name="com.kakao.sdk.auth.AuthCodeHandlerActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:host="oauth" android:scheme="kakaof8898377c9756b28f0d527714d44467e" />
            </intent-filter>
        </activity>
        <activity
            android:name=".AdsGuideActivity"
            android:exported="false" />
        <activity
            android:name=".EmergencyActivity"
            android:exported="false" />
        <activity
            android:name=".NotifActivity"
            android:exported="false" />
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <activity
            android:name=".AnalysisActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:theme="@android:style/Theme.DeviceDefault.Light.Dialog" />
        <service
            android:name=".NewAppJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <activity
            android:name=".StorageActivity"
            android:exported="false" />
    </application>
</manifest>
