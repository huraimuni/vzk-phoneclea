<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 설치된 앱 목록을 읽기 위한 권한. 인터넷 권한은 일부러 넣지 않았습니다(점검 결과가 밖으로 나가지 않음). -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- 사용자가 선택한 앱의 삭제 확인 창을 띄우기 위한 권한 -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- 의심 앱의 백그라운드 실행을 일시 중지(종료)시키기 위한 권한 -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- 저장공간 관리: 중복 사진·영상 찾기 (사용자가 기능을 열 때만 허용 요청) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- 저장공간 관리: 중복 연락처 찾기/삭제 -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <!-- 정확도 향상(선택): 사용자가 설정에서 허용하면 '한 번도 안 열어 본 앱'을 알 수 있음 -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- 새 앱 설치 알림(선택) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="VZK 폰클린"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AdsGuideActivity"
            android:exported="false" />
        <activity
            android:name=".EmergencyActivity"
            android:exported="false" />
        <service
            android:name=".NewAppJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <activity
            android:name=".StorageActivity"
            android:exported="false" />
        <activity
            android:name=".DupMediaActivity"
            android:exported="false" />
        <activity
            android:name=".DupContactsActivity"
            android:exported="false" />
    </application>
</manifest>
